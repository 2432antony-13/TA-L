# Required for AI readings. Never prefix secrets with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high

# Optional comma-separated origins in addition to the production domains.
ALLOWED_ORIGIN=

# Optional: required only for cross-device history persistence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
